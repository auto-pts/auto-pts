          </Row>
          <Row>
            <Name>TSPX_URI</Name>
            <Description>If no URI scheme is in use, or if the URI scheme in use is not defined as either a provisional or permanent scheme, TSPX_URI_scheme shall contain Unicode code point U+0001, represented in UTF-8 as 1 (hexadecimal 0x01) in the first octet. See Core Spec Supplement (CSS) v6, Section 1.1.18 (Default: 000168747470733A2F2F7777772E626C7565746F6F74682E636F6D - https://www.bluetooth.com)</Description>
            <Type>OCTETSTRING</Type>
            <Value>000168747470733A2F2F7777772E626C7565746F6F74682E636F6D</Value>
          </Row>
          <Row>
            <Name>TSPX_periodic_advertising_data</Name>
            <Description>The periodic advertising data in Periodic Advertising Mode from the Lower Tester (Default: 0x0201040503001801180D095054532d4741502d3036423803190000)</Description>
            <Type>OCTETSTRING</Type>
            <Value>0201040503001801180D095054532d4741502d3036423803190000</Value>
          </Row>
          <Row>
            <Name>TSPX_Min_Encryption_Key_Size</Name>
            <Description>Minimum encryption key size, range: 07'O to 10'O. (Default: 07)</Description>
            <Type>OCTETSTRING</Type>
            <Value>07</Value>
          </Row>
          <Row>
            <Name>TSPX_broadcast_code</Name>
            <Description>BIS Broadcast code (16 bytes)</Description>
            <Type>OCTETSTRING</Type>
            <Value>8ED03323D1205E2D58191BF6285C3182</Value>
          </Row>
          <Row>
            <Name>TSPX_gap_iut_role</Name>
            <Description>Indicates the IUT's role: Central or Peripheral. (Default: "Peripheral")</Description>
            <Type>IA5STRING</Type>
            <Value>Peripheral</Value>
            <ValueList>
              <ValueListItem>Central</ValueListItem>
              <ValueListItem>Peripheral</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_Use_IXIT_TSPX_spsm</Name>
            <Description>Determine whether to use TSPX_spsm or MMI prompt for SPSM. (Default: FALSE)</Description>
            <Type>BOOLEAN</Type>
            <Value>FALSE</Value>
          </Row>
          <Row>
            <Name>TSPX_Use_GATT</Name>
            <Description>IUT support GATT. (Default: TRUE)</Description>
            <Type>BOOLEAN</Type>
            <Value>TRUE</Value>
          </Row>
          <Row>
            <Name>TSPX_ead_keys_sharing_method</Name>
            <Type>IA5STRING</Type>
            <Description>EAD test case key sharing method options. This is only used for EAD test cases. If KEYS_SHARED_VIA_IXIT is chosen, TSPX_encrypted_data_key and TSPX_initialization_vector will be used.</Description>
            <Type>OCTETSTRING</Type>
            <Value>KEYS_EXCHANGED_VIA_CONNECTION</Value>
            <ValueList>
              <ValueListItem>KEYS_EXCHANGED_VIA_CONNECTION</ValueListItem>
              <ValueListItem>KEYS_SHARED_VIA_IXIT</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_encrypted_data_key</Name>
            <Description>Encrypted Data Key as BIG Endian. This IXIT is only used for SCN test case (16 bytes)</Description>
            <Type>OCTETSTRING</Type>
            <Value>57A9DA12D12E6E131E20612AD10A6A19</Value>
          </Row>
          <Row>
            <Name>TSPX_initialization_vector</Name>
            <Description>Encrypted Data IV as BIG Endian. This IXIT is only used for SCN test case  (8 bytes)</Description>
            <Type>OCTETSTRING</Type>
            <Value>46E77AB1EF007A9E</Value>
          </Row>
          <Row>
            <Name>TSPX_transient_application_key</Name>
            <Description>Encrypted Data Key as BIG Endian. This IXIT is only used for SCN test case (16 bytes)</Description>
            <Type>OCTETSTRING</Type>
            <Value>57A9DA12D12E6E131E20612AD10A6A19</Value>
            <Helper>TRUE</Helper>
          </Row>
          <Row>
            <Name>TSPX_higher_layer_profile_uuid</Name>
            <Description>Higher Layer Profile defined UUID for TAK</Description>
            <Type>OCTETSTRING</Type>
            <Value>2A19</Value>
            <Helper>TRUE</Helper>
          </Row>
        </Rows>
      </PIXIT>
    </PROJECT_INFORMATION>
