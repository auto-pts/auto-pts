            <Value>TRUE</Value>
            <Mandatory>FALSE</Mandatory>
          </Row>
          <Row>
            <Name>TSPC_BAP_96_1</Name>
            <Description>7.5 ms (O)</Description>
            <Value>TRUE</Value>
            <Mandatory>FALSE</Mandatory>
          </Row>
          <Row>
            <Name>TSPC_BAP_96_2</Name>
            <Description>10 ms (C.1)</Description>
            <Value>TRUE</Value>
            <Mandatory>FALSE</Mandatory>
          </Row>
          <Row>
            <Name>TSPC_ALL</Name>
            <Description>Enables all test cases when set.</Description>
            <Value>FALSE</Value>
            <Mandatory>FALSE</Mandatory>
          </Row>
        </Rows>
      </PICS>
      <PIXIT>
        <Name>BAP</Name>
        <Version />
        <Rows>
          <Row>
            <Name>TSPX_bd_addr_iut</Name>
            <Description>The unique 48-bit Bluetooth device address (BD_ADDR) of the IUT. This was filled in during workspace creation.</Description>
            <Type>OCTETSTRING</Type>
            <Value>112233445566</Value>
          </Row>
          <Row>
            <Name>TSPX_Public_bd_addr_LT2</Name>
            <Description>The public BD Address of the Lower Tester 2. Default: 000000000000)</Description>
            <Type>OCTETSTRING</Type>
            <Value>000000000000</Value>
          </Row>
          <Row>
            <Name>TSPX_iut_device_name_in_adv_packet_for_random_address</Name>
            <Description>IUT advertising this local name for the PTS to make connection to. Default is not using it with empty string. (Default: "")</Description>
            <Type>IA5STRING</Type>
            <Value />
          </Row>
          <Row>
            <Name>TSPX_time_guard</Name>
            <Description>The time in milliseconds, to break PTS from waiting for a required event, if time guard is used by the test case. (Default: 180000)</Description>
            <Type>INTEGER</Type>
            <Value>180000</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_use_implicit_send</Name>
            <Description>Whether to receive a message via Implicit Send when an action or attention is needed by test operator. (Default: TRUE)</Description>
            <Type>BOOLEAN</Type>
            <Value>TRUE</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_tester_database_file</Name>
            <Description>Location of SIG database file. (Default: C:\Program Files\Bluetooth SIG\Bluetooth PTS\Data\SIGDatabase\PTS_BASS_db.xml)</Description>
            <Type>IA5STRING</Type>
            <Value>C:\Program Files\Bluetooth SIG\Bluetooth PTS\Data\SIGDatabase\PTS_BASS_db.xml</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_mtu_size</Name>
            <Description>MTU size. (Default: 64)</Description>
            <Type>INTEGER</Type>
            <Value>64</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_secure_simple_pairing_pass_key_confirmation</Name>
            <Description>Whether to display secure simple pairing pass key confirmation or not. (Default: FALSE)</Description>
            <Type>BOOLEAN</Type>
            <Value>FALSE</Value>
          </Row>
          <Row>
            <Name>TSPX_delete_link_key</Name>
            <Description>Whether to delete link key or not. (Default: FALSE)</Description>
            <Type>BOOLEAN</Type>
            <Value>FALSE</Value>
          </Row>
          <Row>
            <Name>TSPX_pin_code</Name>
            <Description>Pin code to be used for legacy pairing. (Default: 0000)</Description>
            <Type>IA5STRING</Type>
            <Value>0000</Value>
          </Row>
          <Row>
            <Name>TSPX_use_dynamic_pin</Name>
            <Description>Whether to use dynamic pin code entry or not. (Default: FALSE)</Description>
            <Type>BOOLEAN</Type>
            <Value>FALSE</Value>
          </Row>
          <Row>
            <Name>TSPX_delete_ltk</Name>
            <Description>Whether to delete Long Term Key or not. (Default: FALSE)</Description>
            <Type>BOOLEAN</Type>
            <Value>FALSE</Value>
          </Row>
          <Row>
            <Name>TSPX_security_enabled</Name>
            <Description>Whether to set security for the test suite. (Default: FALSE)</Description>
            <Type>BOOLEAN</Type>
            <Value>FALSE</Value>
          </Row>
          <Row>
            <Name>TSPX_iut_ATT_transport</Name>
            <Description>Select a transport which IUT wants to be connected for (Default: ATT Bearer on LE Transport)</Description>
            <Type>IA5STRING</Type>
            <Value>ATT Bearer on LE Transport</Value>
            <ValueList>
              <ValueListItem>ATT Bearer on LE Transport</ValueListItem>
              <ValueListItem>ATT Bearer on BR/EDR Transport</ValueListItem>
              <ValueListItem>EATT Bearer on LE Transport</ValueListItem>
              <ValueListItem>EATT Bearer on BR/EDR Transport</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_TARGET_ASE_CHARACTERISTIC</Name>
            <Description>Target Audio Stream Endpoint Characteristic (This is only used when test spec doesn't specify target ASE)</Description>
            <Type>IA5STRING</Type>
            <Value>SINK_ASE</Value>
            <ValueList>
              <ValueListItem>SINK_ASE</ValueListItem>
              <ValueListItem>SOURCE_ASE</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_TARGET_LATENCY</Name>
            <Description>Target Latency</Description>
            <Type>IA5STRING</Type>
            <Value>TARGET_LOWER_LATENCY</Value>
            <ValueList>
              <ValueListItem>TARGET_LOWER_LATENCY</ValueListItem>
              <ValueListItem>TARGET_BALANCED_LATENCY_RELIABILITY</ValueListItem>
              <ValueListItem>TARGET_HIGHER_RELIABILITY</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_TARGET_PHY</Name>
            <Description>PHY parameter target to achieve the Target_Latency value</Description>
            <Type>IA5STRING</Type>
            <Value>LE_2M_PHY</Value>
            <ValueList>
              <ValueListItem>LE_1M_PHY</ValueListItem>
              <ValueListItem>LE_2M_PHY</ValueListItem>
              <ValueListItem>LE_CODED_PHY</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_Codec_ID</Name>
            <Description>Octet 0: Coding format.'06' is default LC3 codec. For the vendor specific codec, Please set this 'ff' value and set TSPX_VS_Company_ID and TSPX_VS_Codec_ID accordingly (Default: 06)</Description>
            <Type>OCTETSTRING</Type>
            <Value>06</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_Codec_Specific_Capabilities</Name>
            <Description>Vendor_Specific_Capability LTVs in PAC. Total vendor specific capability length will be calculated and automatically added. Data must be LTV structure with litte endian for multi-octet ex)length: 3, type: 4, value: 0x0028 =&gt; 03042800 (Default: 0301F50002020302030105041A00C800)</Description>
            <Type>OCTETSTRING</Type>
            <Value>0301F50002020302030105041A00C800</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_Codec_Specific_Configuration</Name>
            <Description>Vendor-Specific codec specific configuration. Total codec configuration length will be calculated and automatically added. Data must be LTV structure with litte endian for multi-octet ex)length: 3, type: 4, value: 0x0028 =&gt; 03042800 (Default: 02010802020005030100000003047500)</Description>
            <Type>OCTETSTRING</Type>
            <Value>02010802020005030100000003047500</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_QoS_Framing</Name>
            <Description>Select Framing (Default: UNFRAMING)</Description>
            <Type>IA5STRING</Type>
            <Value>UNFRAMING</Value>
            <ValueList>
              <ValueListItem>UNFRAMING</ValueListItem>
              <ValueListItem>FRAMING</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_VS_QoS_PHY</Name>
            <Description>Select PHY (Default: 2M_PHY)</Description>
            <Type>IA5STRING</Type>
            <Value>2M_PHY</Value>
            <ValueList>
              <ValueListItem>1M_PHY</ValueListItem>
              <ValueListItem>2M_PHY</ValueListItem>
              <ValueListItem>CODED_PHY</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_VS_QoS_SDU_Interval</Name>
            <Description>TSPX_VS_QoS_SDU_Interval(usec). (Default: 10000)</Description>
            <Type>INTEGER</Type>
            <Value>7500</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_QoS_Max_SDU</Name>
            <Description>TSPX_VS_QoS_Max_SDU. (Default: 40)</Description>
            <Type>INTEGER</Type>
            <Value>40</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_QoS_Retransmission_Number</Name>
            <Description>TSPX_VS_QoS_Retransmission_Number(msec). (Default: 2)</Description>
            <Type>INTEGER</Type>
            <Value>2</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_QoS_Max_Transport_Latency</Name>
            <Description>TSPX_VS_QoS_Max_Transport_Latency(msec). (Default: 10)</Description>
            <Type>INTEGER</Type>
            <Value>10</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_QoS_Presentation_Delay</Name>
            <Description>TSPX_VS_QoS_Presentation_Delay(usec). (Default: 40000)</Description>
            <Type>INTEGER</Type>
            <Value>40000</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_Company_ID</Name>
            <Description>Company Id for vendor specific. This is a big-endian format. ex)0001 means 0x0001. Please Set TSPX_Codec_ID value to 0xFF to test VS related test case. (Default: 0000)</Description>
            <Type>OCTETSTRING</Type>
            <Value>0000</Value>
          </Row>
          <Row>
            <Name>TSPX_VS_Codec_ID</Name>
            <Description>Codec Id for vendor specific. This is a big-endian format. ex)0001 means 0x0001. Please Set TSPX_Codec_ID value to 0xFF to test VS related test case. (Default: 0000)</Description>
            <Type>OCTETSTRING</Type>
            <Value>0000</Value>
          </Row>
          <Row>
            <Name>TSPX_STREAMING_DATA_CONFIRMATION_METHOD</Name>
            <Description>Select steraming data confirmation method. If Sample Rate in QoS Configuration IXIT is set to 44.1kHz such as 441_1_1, only By Displaying is used.(Default: By Displaying)</Description>
            <Type>IA5STRING</Type>
            <Value>By Displaying</Value>
            <ValueList>
              <ValueListItem>By Playing</ValueListItem>
              <ValueListItem>By Displaying</ValueListItem>
            </ValueList>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_METADATA_SELECTION</Name>
            <Description>If USE_IXIT_VALUE_FOR_METADATA is selected, it will use IXIT value below. Otherwise, it will use first matching sampling freq, duration, and SDU size (Default: DO_NOT_USE_IXIT_VALUE_FOR_METADATA)</Description>
            <Type>IA5STRING</Type>
            <Value>DO_NOT_USE_IXIT_VALUE_FOR_METADATA</Value>
            <ValueList>
              <ValueListItem>DO_NOT_USE_IXIT_VALUE_FOR_METADATA</ValueListItem>
              <ValueListItem>USE_IXIT_VALUE_FOR_METADATA</ValueListItem>
            </ValueList>
          </Row>
          <Row>
            <Name>TSPX_METADATA_SINK</Name>
