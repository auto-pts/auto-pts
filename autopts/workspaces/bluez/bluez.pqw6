            <Type>OCTETSTRING</Type>
            <Value>0000000000000000FE12036E5A889F4D</Value>
          </Row>
          <Row>
            <Name>TSPX_tester_role_optional</Name>
            <Description>This value determines which Role the Tester is, for test cases where Tester Role is optional (SM/CEN/SIGN). Valid values are L2CAP_ROLE_INITIATOR or L2CAP_ROLE_ACCEPTOR.</Description>
