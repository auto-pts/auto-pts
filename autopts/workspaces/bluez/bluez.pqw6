    <PROJECT_INFORMATION NAME="GAP" TC_LOG="tc_log.xml" TC_SCRIPT="tc_sqript.xml" USERDLL="" USE_USERDLL="False" RUNTIME_LOGGING="False">
      <PICS>
        <Name>GAP</Name>
        <Rows>
          <Row>
            <Name>TSPC_GAP_0b_1</Name>
            <Description>GAP BR/EDR Host (C.1, C.3)</Description>
            <Value>TRUE</Value>
            <Mandatory>FALSE</Mandatory>
          </Row>
          <Row>
            <Name>TSPC_GAP_0b_2</Name>
