          </Row>
          <Row>
            <Name>TSPX_Sync_Timeout</Name>
            <Description>Synchronization timeout for the periodic advertising train. Range: 10 to 0x4000. Time = TSPX_Sync_Timeout * 10 ms (Default: 3000, which is 30 seconds)</Description>
            <Type>INTEGER</Type>
            <Value>3000</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_Broadcast_ID</Name>
            <Description>Broadcast ID. Valid Range is 0 to 16777215 (0xFFFFFF). When this value is valid, PTS will search for the matching device. If it is -1 (0xFFFFFFFF), PTS will search by Bluetooth address</Description>
            <Type>INTEGER</Type>
            <Value>-1</Value>
          </Row>
          <Row>
            <Name>TSPX_Broadcast_ID_2</Name>
            <Description>Second Broadcast ID. This is only used for BAP/BSRC/SCC/BV-38-C test case</Description>
            <Type>INTEGER</Type>
            <Value>0</Value>
          </Row>
          <Row>
            <Name>TSPX_Connection_Interval</Name>
            <Description>Connection interval for specific sampling frequency. unit 1.25ms(Default: 64 = 80ms)</Description>
            <Type>INTEGER</Type>
            <Value>64</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_Extended_Adv_Interval_min</Name>
            <Description>Min Extended Advertisement interval for Extended Advertisement unit 0.625ms. Only used in BSNK test case group (Default: 1200 = 750ms)</Description>
            <Type>INTEGER</Type>
            <Value>1200</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_Extended_Adv_Interval_max</Name>
            <Description>Max Extended Advertisement interval for Extended Advertisement unit 0.625ms. Only used in BSNK test case group(Default: 1200 = 750ms)</Description>
            <Type>INTEGER</Type>
            <Value>1200</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_Periodic_Adv_Interval_min</Name>
            <Description>Min Periodic Advertisement interval for Periodic Advertisement. Only used in BSNK test case group. unit 1.25ms(Default: 600 = 750ms)</Description>
            <Type>INTEGER</Type>
            <Value>600</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_Periodic_Adv_Interval_max</Name>
            <Description>Max Periodic Advertisement interval for Periodic Advertisement. Only used in BSNK test case group. unit 1.25ms(Default: 600 = 750ms)</Description>
            <Type>INTEGER</Type>
            <Value>600</Value>
            <PTS>TRUE</PTS>
          </Row>
          <Row>
            <Name>TSPX_EXPOSE_CSIS</Name>
            <Description>Expose CSIS Instance. (Default: FALSE)</Description>
            <Type>BOOLEAN</Type>
            <Value>FALSE</Value>
          </Row>
          <Row>
            <Name>TSPX_sirk</Name>
            <Description>The 16 bytes SIRK value. (Default: 0X838E680553F1415AA265BBAFC6EA03B8)</Description>
            <Type>OCTETSTRING</Type>
            <Value>838E680553F1415AA265BBAFC6EA03B8</Value>
            <PTS>TRUE</PTS>
          </Row>
        </Rows>
      </PIXIT>
